# Copy to .env. Read once at startup by src/lib/env.ts (zod-validated).

# --- Server ---
# Bind to localhost only; v1 has no login.
KITFORGE_HOST=127.0.0.1
KITFORGE_PORT=4317

# --- Database ---
# Single SQLite file. Tests override this with .data/e2e.db.
KITFORGE_DB_PATH=~/.kitforge/kitforge.db

# --- LLM ---
# mock = scripted responses + /api/test/reset enabled (tests only; reset wipes the DB). real = OpenRouter.
KITFORGE_LLM_MODE=mock
# OpenRouter key (openrouter.ai/keys). Not needed in mock mode. Set a credit limit on the key.
OPENROUTER_API_KEY=
# OpenRouter model id used for analysis and proposals, e.g. one listed at openrouter.ai/models. Required when real.
KITFORGE_MODEL=
# Optional override; defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# --- CLI ---
# Where the `kit` CLI finds the app.
KITFORGE_URL=http://127.0.0.1:4317
# `kit report` gives up after this long and queues the report in ~/.kitforge/outbox/.
KITFORGE_REPORT_TIMEOUT_MS=10000

# --- Testing ---
# Set to 1 (with KITFORGE_LLM_MODE=real and a key) to run the @smoke suite.
RUN_SMOKE=0
# Optional: path to a real Claude Code transcript (.jsonl) that used an installed kit, for SMOKE-4.
KITFORGE_SMOKE_TRANSCRIPT=
